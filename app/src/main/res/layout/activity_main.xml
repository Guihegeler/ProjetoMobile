<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imgAbacaxi"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:src="@drawable/abacaxi" />

    <ImageView
        android:id="@+id/imgAbobora"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bobora"
        android:layout_below="@+id/imgAbacaxi"
        />

    <ImageView
        android:id="@+id/imgMorango"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:src="@drawable/morango"
        android:layout_below="@+id/imgAbobora"
        />

    <ImageView
        android:id="@+id/imgCenoura"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:src="@drawable/carrot"
        android:layout_below="@id/imgMorango"

        />


</RelativeLayout>